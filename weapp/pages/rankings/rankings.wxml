<view class="paper-bg">
  <view class="safe-page page-pad">
    <view class="page-title">期刊榜单</view>

    <view wx:for="{{groups}}" wx:key="title" class="rank-section">
      <view class="section-title">{{item.title}}</view>
      <view class="rank-grid">
        <view wx:for="{{item.items}}" wx:for-item="rank" wx:key="slug" class="rank-card card" bindtap="openRank" data-type="{{rank.type}}" data-slug="{{rank.slug}}" data-title="{{rank.title}}">
          <view class="rank-title">{{rank.title}}</view>
          <view class="rank-sub">{{rank.count}}</view>
          <view class="rank-arrow">›</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="bottom-tab" bindtap="goTab" data-url="/pages/index/index"><text class="tab-icon">⌂</text><text>首页</text></view>
    <view class="bottom-tab active"><text class="tab-icon">☷</text><text>榜单</text></view>
    <view class="bottom-tab" bindtap="goTab" data-url="/pages/favorites/favorites"><text class="tab-icon">♡</text><text>收藏</text></view>
    <view class="bottom-tab" bindtap="goTab" data-url="/pages/profile/profile"><text class="tab-icon">♙</text><text>我的</text></view>
  </view>
</view>
