<view class="paper-bg">
  <view class="safe-page page-pad">
    <view class="folder-head card">
      <view class="page-title">{{folder.title}}</view>
      <view class="page-sub">{{folder.desc}}</view>
      <button class="share-btn" open-type="share">分享这个 list</button>
    </view>

    <view class="journal-list">
      <view wx:for="{{folder.journals}}" wx:key="slug" class="journal-card card" bindtap="openDetail" data-slug="{{item.slug}}">
        <view class="journal-title">{{item.title}}</view>
        <view class="journal-meta">ISSN {{item.issn}}</view>
        <view class="metrics">
          <text>IF {{item.ifText}}</text>
          <text>JCR {{item.jcr}}</text>
          <text>中科院 {{item.cas}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
