# Disable browser caching for JS/CSS — WeChat browser ignores query strings
# and has broken Service Worker support, causing stale content.
/js/*
  Cache-Control: no-cache, no-store, must-revalidate
/css/*
  Cache-Control: no-cache, no-store, must-revalidate
/data/*.json.gz
  Cache-Control: public, max-age=31536000, immutable
/data/*.gz
  Cache-Control: public, max-age=31536000, immutable
/data/*.json
  Cache-Control: public, max-age=3600
