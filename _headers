# Disable browser caching for JS/CSS — WeChat browser ignores query strings
# and has broken Service Worker support, causing stale content.
/js/*
  Cache-Control: no-cache, no-store, must-revalidate
/css/*
  Cache-Control: no-cache, no-store, must-revalidate
# Ensure HTML is always served as UTF-8 (avoids mojibake on listing pages)
/indexes/*
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
/indexes
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
/subjects/*
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
/*.html
  Content-Type: text/html; charset=utf-8
/data/*.json.gz
  Cache-Control: public, max-age=31536000, immutable
/data/*.gz
  Cache-Control: public, max-age=31536000, immutable
/data/ext_lookup_v3_shards/*
  Cache-Control: public, max-age=31536000, immutable
/data/*.json
  Cache-Control: public, max-age=3600
